{
  "name": "markdown-sharing-slides",
  "private": true,
  "scripts": {
    "preview": "marp --server --watch .",
    "html": "marp slides.md -o slides.html",
    "pdf": "marp slides.md --pdf --allow-local-files -o slides.pdf",
    "pptx": "marp slides.md --pptx -o slides.pptx",
    "build:legacy": "node build-slides.js"
  },
  "devDependencies": {
    "@marp-team/marp-cli": "^4.5.1"
  },
  "dependencies": {
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.3.0",
    "sharp": "^0.33.5"
  }
}
